# Uploaded media is served from here as static files.
# Nothing in this directory may ever be executed.
#
# Access is DENIED by filename rather than by turning the PHP engine off,
# because `php_flag` only exists when mod_php is loaded. On a PHP-FPM or CGI
# host it is an invalid directive and Apache answers every request in this
# directory with 500 — verified on Apache 2.4.58 without mod_php. Denying the
# files outright works under every PHP SAPI.
<FilesMatch "(?i)\.(php|phtml|phps|php[0-9]|pht|phar|inc|cgi|pl|py|sh|bat|exe|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Belt and braces where mod_php IS present (XAMPP's default).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule php_module>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

<IfModule mod_headers.c>
    # setifempty, not set: the parent public/.htaccess already sends this, and
    # `set` in a nested context appends a second identical header. `always`
    # matches the parent, which writes to the err_headers_out table — a plain
    # setifempty inspects the other table and so never sees it.
    Header always setifempty X-Content-Type-Options "nosniff"

    # A one-year immutable cache is only safe because every URL the templates
    # emit carries ?v=<media.updated_at>. Replacing a photograph creates a new
    # storage key AND a new version string, so a visitor holding the old file
    # is never asked to revalidate and still sees the replacement immediately.
    # Without that versioning this directive would pin a stale photo for a year.
    <FilesMatch "(?i)\.(jpe?g|png|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

Options -Indexes -ExecCGI
