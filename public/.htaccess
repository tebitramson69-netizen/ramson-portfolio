# ---------------------------------------------------------------------------
#  Front controller + baseline hardening
#  Only this directory is exposed by the web server.
# ---------------------------------------------------------------------------

# The project root denies everything (see ../.htaccess). This is the one
# directory that is meant to be reachable, so it grants access back.
Require all granted

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # NO RewriteBase.
    #
    # In .htaccess (per-directory) context, mod_rewrite resolves a relative
    # substitution against the directory the .htaccess sits in. Letting Apache
    # work that out is what makes BOTH layouts work from one file:
    #
    #   vhost      DocumentRoot -> .../public        http://portfolio.test/work/rendo
    #   XAMPP      DocumentRoot -> .../htdocs        http://localhost/ramson-portfolio/public/work/rendo
    #
    # Setting "RewriteBase /" pins the base to the SERVER root, so
    # "RewriteRule ^ index.php" becomes /index.php — the document root's own
    # index, not this project's. Verified on Apache 2.4.58: with RewriteBase /
    # a request for /ramson-portfolio/public/work/rendo was served by
    # htdocs/index.php.

    # Redirect trailing slashes on non-directories: /work/rendo/ -> /work/rendo
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve existing files and directories untouched (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles (.git, .env, .htaccess ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes -MultiViews

<IfModule mod_headers.c>
    # Security headers are also sent from PHP (see src/Core/SecurityHeaders.php)
    # so they apply to static assets served directly by Apache too.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif            "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>
