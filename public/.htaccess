# ---------------------------------------------------------------------------
#  Front controller + baseline hardening
#  Only this directory is exposed by the web server.
# ---------------------------------------------------------------------------

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Respect a subdirectory install (e.g. http://localhost/ramson-portfolio/public)
    RewriteBase /

    # Redirect trailing slashes on non-directories: /work/rendo/ -> /work/rendo
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve existing files and directories untouched (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles (.git, .env, .htaccess ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes -MultiViews

<IfModule mod_headers.c>
    # Security headers are also sent from PHP (see src/Core/SecurityHeaders.php)
    # so they apply to static assets served directly by Apache too.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif            "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>
